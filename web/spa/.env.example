# live (mặc định, dùng cho demo chấm điểm) | mock (chỉ phát triển UI, có nhãn DỮ LIỆU MINH HỌA)
VITE_DATA_MODE=live
# Đường dẫn same-origin; dev server và Nginx proxy /api -> backend.
VITE_API_BASE=/api
# URL repo công khai (để trống nếu chưa có -> nút GitHub bị tắt)
VITE_GITHUB_URL=
# Chỉ dùng phía dev server (KHÔNG có tiền tố VITE_, không vào bundle):
# BACKEND_URL=http://127.0.0.1:8000
# TEST_API_KEY đọc từ ../../.env
