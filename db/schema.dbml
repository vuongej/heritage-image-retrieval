// =====================================================================
//  Heritage Image Retrieval — schema đang chạy (22/10/2026)
//  Pipeline B: SQLite data/local/catalog.sqlite3 (storage/local.py) + vectors.npy
//  Pipeline A: file trong PROCESS_DIR (processing/), không dùng DB
//  Thiết kế Postgres/S3 ban đầu xem lịch sử git của file này.
// =====================================================================

Project heritage {
  database_type: 'SQLite'
  Note: 'Một file SQLite chứa catalog, FTS5, cache và KG; vector nằm ở vectors.npy (float32, rownum - 1)'
}

// ---------------------------------------------------------------- Pipeline B: catalog

Table entities {
  entity_id    text [pk]
  entity_name  text
  entity_slug  text
  parent_class text [note: 'nhóm category; dùng cho set query và filter']
}

Table images {
  rownum        integer [pk, note: 'hàng thứ rownum-1 của vectors.npy, point id Qdrant']
  image_id      text    [unique, note: 'UUID5 từ image_url']
  entity_id     text    [ref: > entities.entity_id]
  image_url     text
  page_url      text
  description   text
  metadata_text text    [note: 'tên + category + mô tả: đầu vào embedding và FTS5']
  record_json   text    [note: 'dòng CSV gốc']
  verify        text    [note: 'yes | no | NULL (unknown)']
  verify_source text    [note: 'human | model']
  width         integer
  height        integer
  has_watermark integer
  fetch_status  text
  caption       text
  caption_source text
}

Table image_fts {
  rowid integer [ref: - images.rownum]
  text  text [note: 'FTS5 trên metadata_text đã bỏ dấu (BM25)']
}

Table metadata {
  key   text [pk, note: 'csv_sha256, dimensions_known, ...']
  value text
}

Table llm_cache {
  key   text [pk, note: 'search:v7:* (kết quả /v1/search), deepseek:*, parse LLM']
  value text
}

Table graph_edges {
  src_id   text [pk]
  relation text [pk, note: 'IN_CLASS']
  dst_id   text [pk]
}

// ---------------------------------------------------------------- Pipeline B: KG cho multi-hop

Table kg_node {
  node_id    text [pk, note: 'person:gia-long, place:...']
  kind       text [note: 'person | place']
  label      text
  gender     text
  created_by text [note: 'seed | gemini_doc | online']
  created_at text
}

Table kg_alias {
  alias_norm text [pk]
  node_id    text [pk, ref: > kg_node.node_id]
}

Table kg_edge {
  subject     text [pk, ref: > kg_node.node_id]
  predicate   text [pk, note: 'PARENT_OF | SPOUSE_OF | BURIED_AT | WORSHIPPED_AT | MEMORIAL_AT']
  object      text [pk, ref: > kg_node.node_id]
  source_url  text [pk, note: 'nguồn bằng chứng']
  source_type text
  evidence    text [note: 'câu trích nguyên văn']
  verified    integer
  reviewed    integer
  verifier    text
  confidence  real
  created_at  text
}

Table kg_link {
  node_id   text [pk, ref: > kg_node.node_id]
  entity_id text [pk, ref: > entities.entity_id]
  method    text [note: 'nối node nơi chốn với entity có ảnh']
}

Table kg_lookup {
  lookup_key text [pk, note: 'tra cứu online đã chạy (cache âm có TTL)']
  status     text
  detail     text
  created_at text
}

// ---------------------------------------------------------------- Pipeline A: artifact (file)

Table process_job {
  id         text [pk, note: 'PROCESS_DIR/jobs/<id>/status.json']
  filename   text
  status     text [note: 'queued | running | done | failed | cancelled | interrupted']
  options    json [note: 'use_vlm, vlm_budget, threshold']
  input      json [note: 'rows, columns, mapping, entities, labelled']
  stages     json [note: 'parse, gate, fetch, embed, classify, route, vlm, finalize: done/total/seconds']
  summary    json [note: 'duyệt/loại, lý do, chi phí, throughput, metric theo nhãn người']
}

Table process_result {
  job_id      text [ref: > process_job.id, note: 'jobs/<id>/results.jsonl + results.csv']
  line        integer
  key         text [note: 'sha256(image_url): khoá cache ảnh / embedding dùng chung giữa các job']
  entity_id   text
  image_url   text
  label       text [note: 'nhãn người từ CSV nếu có']
  decision    text [note: 'yes | no']
  stage       text [note: 'rule | classifier | vlm']
  reason      text [note: 'dead, too_small, dup_sha256, classifier_yes, vlm_sai, ...']
  p_yes       real
  routed      boolean
  vlm         json [note: 'subject, watermark, unsafe, evidence']
}

Table process_fetch_cache {
  key    text [pk, note: 'PROCESS_DIR/fetch.jsonl + thumbs/<xx>/<key>.jpg']
  status text [note: 'ok | too_small | dead']
  sha256 text
  w      integer
  h      integer
  bytes  integer
  ms     integer
}
