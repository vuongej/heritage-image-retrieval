# =====================================================================
#  TẤT CẢ BIẾN DƯỚI ĐÂY ĐỀU OPTIONAL.
#  Copy file này thành .env rồi chạy `make up` là hệ thống chạy được ngay.
# =====================================================================

# ---- LLM (optional) -------------------------------------------------
# none = không cần key (mặc định) | local = Ollama | gemini = cần key
LLM_PROVIDER=none
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LOCAL_LLM_BASE_URL=http://ollama:11434
LOCAL_LLM_MODEL=qwen3.5:2b
LOCAL_VLM_MODEL=qwen3-vl:4b

# ---- Embedding / Rerank (chạy local, không cần key) -----------------
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_ONNX_PATH=/models/siglip2.onnx
EMBED_DIM=384
EMBED_BACKEND=torch
EMBED_THREADS=8
EMBED_BATCH_SIZE=64
RETRIEVAL_BACKEND=local
RERANK_MODEL=bge-reranker-v2-m3
RERANK_TOP_K=100
RERANK_KEEP=10
# Rerank LLM: Gemini qua OpenRouter (cần OPENROUTER_API_KEY và LLM_PROVIDER != none)
RERANK_LLM_MODEL=google/gemini-3.5-flash-lite

# ---- S3 / MinIO -----------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_BUCKET=heritage-images
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

# ---- Postgres / Redis / Qdrant --------------------------------------
POSTGRES_DSN=postgresql://app:app@postgres:5432/heritage
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# ---- API key cho auto test ------------------------------------------
# Đặt API_KEY_ENFORCE=false để tắt kiểm tra key khi dev local
API_KEY_ENFORCE=true
API_KEY_SALT=dev-salt-change-me
TEST_API_KEY=gsk_test_dev_only

# ---- SLO ------------------------------------------------------------
SLO_P95_MS=1500
LLM_PARSE_TIMEOUT_MS=600

# ---- Jev (TypeSafe) qua OpenRouter — tầng quyết định của pipeline verify -----
# Lấy key tại https://openrouter.ai/keys rồi dán vào dòng dưới (không có dấu nháy).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter chỉ phục vụ Jev dưới dạng router: typesafe/jev-router
JEV_MODEL=typesafe/jev-router
JEV_MAX_TOKENS=300
# Để trống = router tự chọn; hoặc low | medium | high
JEV_REASONING_EFFORT=

# ---- Pipeline verify (python -m pipeline.verify) ------------------------------
VERIFY_DIR=data/verify
VERIFY_ENCODER=google/siglip2-base-patch16-256
VERIFY_AUDIT_SIZE=300
# Đơn giá deepseek-flash (USD / 1M token), giờ cao điểm, api-docs.deepseek.com 20/10/2026.
# Ngoài giờ cao điểm = 1/2. Cao điểm: 01-04h và 06-10h UTC (08-11h, 13-17h giờ VN), T2-T6.
DEEPSEEK_PRICE_INPUT_PER_MTOK=0.3
DEEPSEEK_PRICE_CACHE_HIT_PER_MTOK=0.006
DEEPSEEK_PRICE_OUTPUT_PER_MTOK=1.2
# ---- Phần B: parse truy vấn bằng LLM qua OpenRouter (speculative, không chặn /v1/search) ----
# Bật khi LLM_PROVIDER != none và có OPENROUTER_API_KEY. Model bắt buộc reasoning -> minimal.
LLM_ONLINE_MODEL=google/gemini-3.5-flash-lite
LLM_BATCH_MODEL=google/gemini-3.5-flash-lite:batch
LLM_PARSE_REASONING=minimal
LLM_HARD_TIMEOUT_MS=6000
LLM_PARSE_WORKERS=4
# ---- Embedding text qua endpoint OpenAI-compatible (thay MiniLM local) ----
# EMBED_BACKEND=api | torch (MiniLM local, 384d). Đổi backend/model -> phải build lại index.
# EMBED_BACKEND=api
# EMBED_MODEL=qwen3-embedding-4b
# EMBED_DIM=2560
EMBED_API_BASE=
EMBED_API_KEY=
EMBED_API_BATCH=128
EMBED_API_WORKERS=4
# Endpoint giới hạn 100 request/phút/key (dùng chung embedding + rerank): client tự giữ nhịp
EMBED_API_RPM=95
# ---- Phần B V2 (docs/RETRIEVAL_PIPELINE_V2_DATA_DRIVEN_PLAN.md) ----
# Rerank: local_ce (mặc định, BGE-v2-m3 Apache-2.0 trên GPU local) | api (jina qua endpoint) | llm (Gemini) | embedding
RERANK_BACKEND=local_ce
RERANK_LOCAL_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_LOCAL_MODEL=Qwen/Qwen3-Reranker-0.6B   # chất lượng tương đương BGE trên bộ 244 ca, chậm hơn ~5 lần
RERANK_CUTOFF_MODE=none                         # legacy_llm_0.2 = hành vi cũ (cắt điểm Gemini < 0,2)
RERANK_MIN_RELEVANCE=0.2                        # ngưỡng điểm gốc cross-encoder; 0 = tắt (scripts/calibrate_relevance.py)
# Parse LLM: ambiguous_only (chỉ gọi khi rule chưa neo chắc tên thực thể) | always | off
LLM_PARSE_MODE=ambiguous_only
LLM_PARSE_CAN_OVERRIDE_CONFIDENT_RULE=false
# Multi-hop: KG dựng offline từ Wikidata, cần liên hệ thật trong User-Agent (chính sách Wikimedia)
WIKIDATA_CONTACT=
# Bộ dữ liệu nguồn duy nhất cho mọi luồng (Phần A, Phần B, đo lường)
SOURCE_CSV=data/data_anh_pass_master.csv
# ---- Multi-hop KG không phụ thuộc Wikidata (docs/multihop-kg.md) ----
HOP_ONLINE=on                         # giai đoạn 3: tra web khi KG thiếu cạnh (cần OPENROUTER_API_KEY)
HOP_ONLINE_BUDGET_MS=2500             # chờ tối đa trong request; quá hạn -> pending, chạy nền tiếp
KG_ONLINE_ENGINE=exa                  # exa: luôn có URL + đoạn trang nguồn; native: hay mất trích dẫn
KG_ONLINE_RESULTS=4
KG_ONLINE_NEGATIVE_TTL_DAYS=7         # cache "không tìm thấy" để không trả tiền tra lại
KG_EXTRACT_MODEL=google/gemini-3.5-flash-lite
KG_JUDGE_MODEL=google/gemini-3.5-flash-lite
