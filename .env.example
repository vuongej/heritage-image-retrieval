# =====================================================================
#  cp .env.example .env  rồi điền các dòng có ghi BẮT BUỘC.
#  Mọi biến khác đã có giá trị dùng được. Không commit file .env.
# =====================================================================

# ---- Khoá nội bộ giữa web proxy và hai service -----------------------
API_KEY_ENFORCE=true
# đổi khi deploy công khai
TEST_API_KEY=gsk_test_dev_only
API_KEY_SALT=dev-salt-change-me

# ---- Pipeline B · embedding + rerank qua endpoint OpenAI/Jina-compatible ----
# BẮT BUỘC cho tìm kiếm: index đi kèm được dựng bằng qwen3-embedding-4b (2.560 chiều);
# đổi model/backend phải dựng lại index (README §3).
EMBED_BACKEND=api
EMBED_MODEL=qwen3-embedding-4b
EMBED_DIM=2560
# BẮT BUỘC, vd https://<endpoint>/v1
EMBED_API_BASE=
# BẮT BUỘC
EMBED_API_KEY=
EMBED_API_BATCH=128
EMBED_API_WORKERS=4
# hạn mức endpoint 100 request/phút/key (chung embedding + rerank)
EMBED_API_RPM=95
# api (jina-reranker-v2 qua endpoint) | local_ce (BGE, cần GPU) | embedding
RERANK_BACKEND=api
RERANK_API_MODEL=jina-reranker-v2
RERANK_TOP_K=24
RERANK_MIN_RELEVANCE=0.2
# numpy (cosine chính xác) | qdrant (HNSW, cần QDRANT_URL)
VECTOR_BACKEND=numpy

# ---- Pipeline B · hạn chờ (retrieval/budget.py) ------------------------
# hạn chờ tổng mỗi /v1/search (SLO < 3 s)
SEARCH_DEADLINE_S=2.7
EMBED_QUERY_DEADLINE_S=2.0
RERANK_API_DEADLINE_S=2.0
LLM_PARSE_TIMEOUT_MS=600
HOP_ONLINE_BUDGET_MS=1800

# ---- Pipeline B · LLM (tuỳ chọn: parse câu mơ hồ, tra KG online) ------
# Không có key: rule parser + KG offline vẫn chạy đủ 3 loại truy vấn.
# none = tắt LLM; khác none + OPENROUTER_API_KEY = bật parse / tra KG
LLM_PROVIDER=deepseek
# chỉ gọi LLM khi rule chưa neo chắc tên entity
LLM_PARSE_MODE=ambiguous_only
LLM_PARSE_CAN_OVERRIDE_CONFIDENT_RULE=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_ONLINE_MODEL=google/gemini-3.5-flash-lite
HOP_ONLINE=on
KG_ONLINE_ENGINE=exa

# ---- Pipeline A · VLM cho ảnh khó (tuỳ chọn) --------------------------
# Không có key: processing service vẫn chạy rule + SigLIP2 + LightGBM, bỏ tầng VLM.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Đơn giá (USD / 1M token) để tính chi phí job; giờ cao điểm, api-docs.deepseek.com 20/10/2026.
DEEPSEEK_PRICE_INPUT_PER_MTOK=0.3
DEEPSEEK_PRICE_CACHE_HIT_PER_MTOK=0.006
DEEPSEEK_PRICE_OUTPUT_PER_MTOK=1.2

# ---- Pipeline A · processing service ----------------------------------
# ảnh tải về, cache embedding, job (dev local)
PROCESS_DIR=data/process
PROCESS_MAX_ROWS=50000
PROCESS_MAX_UPLOAD_MB=50
PROCESS_FETCH_WORKERS=32
VERIFY_ENCODER=google/siglip2-base-patch16-256
# chỉ cho `python -m pipeline.verify` (pilot cũ)
VERIFY_DIR=data/verify

# ---- Dữ liệu nguồn / index -------------------------------------------
SOURCE_CSV=data/data_anh_pass_master.csv
# Kéo index dựng sẵn từ HF dataset private khi container api khởi động (deploy/hf_data.py)
HF_DATASET=
# token quyền Read
HF_TOKEN=

# ---- Web dev (vite) ---------------------------------------------------
BACKEND_URL=http://127.0.0.1:8000
PROCESS_URL=http://127.0.0.1:8100
